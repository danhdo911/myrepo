################### Project Configurations ####################
{% for project in projects %}
module "{{ project.project_name }}" {
  source = "../../modules/ops/identity/identity_project"

  project_name = "{{ project.project_name }}"
  description  = "{{ project.descriptions }}"
}

module "{{ project.project_name }}_admin_user" {
  source     = "../../modules/ops/identity/identity_users"
  depends_on = [module.{{ project.project_name }}]

  project_id    = module.{{ project.project_name }}.id
  user_name     = var.user_name
  user_password = var.user_password
  {% if project.domain %}
  email         = "${var.user_name}{{'@' ~ project.domain }}"
  {% endif %}
}

module "{{ project.project_name }}_group" {
  source = "../../modules/ops/identity/identity_group"

  group = "{{ project.project_name }}_Group"
}

module "{{ project.project_name }}_membership" {
  source     = "../../modules/ops/identity/identity_membership"
  depends_on = [module.{{ project.project_name }}_admin_user, module.{{ project.project_name }}_group]

  user_id  = module.{{ project.project_name }}_admin_user.id
  group_id = module.{{ project.project_name }}_group.id
}

module "{{ project.project_name }}_role_assignment" {
  source     = "../../modules/ops/identity/identity_role_assignment"
  depends_on = [module.{{ project.project_name }}_group, module.{{ project.project_name }}]

  group_id   = module.{{ project.project_name }}_group.id
  project_id = module.{{ project.project_name }}.id
  role_id    = data.openstack_identity_role_v3.role.id
}

module "{{ project.project_name }}_quota_blockstorage" {
  source     = "../../modules/ops/quota/quota_blockstorage"
  depends_on = [module.{{ project.project_name }}]

  project_id = module.{{ project.project_name }}.id
}

module "{{ project.project_name }}_quota_compute" {
  source     = "../../modules/ops/quota/quota_compute"
  depends_on = [module.{{ project.project_name }}]

  project_id = module.{{ project.project_name }}.id
}

module "{{ project.project_name }}_quota_network" {
  source     = "../../modules/ops/quota/quota_network"
  depends_on = [module.{{ project.project_name }}]

  project_id = module.{{ project.project_name }}.id
}
{% endfor %}