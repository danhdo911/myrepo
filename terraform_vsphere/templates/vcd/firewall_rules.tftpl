module "firewall_rules" {
    source           = "../../modules/vcd/firewall_rule"
    vcd_org          = var.vcd_org
    edge_gateway_id  = data.vcd_nsxt_edgegateway.edgegateway.id

    rules = [{% for rule in rules %}
        {
            name        = "{{ rule.name }}"
            direction   = "{{ rule.direction }}"
            ip_protocol = "{{ rule.ip_protocol }}"
            action      = "{{ rule.action }}"

            {% if rule.source_ids %}
            source_ids = [
            {%- for id in rule.source_ids -%}
                {{ "module.ip_set_" + id + ".id" if rule.type == "IPSet" else id }}{% if not loop.last %}, {% endif %}
            {%- endfor -%}
            ]
            {% endif %}

            {% if rule.destination_ids %}
            destination_ids = [
            {%- for id in rule.destination_ids -%}
                {{ "module.ip_set_" + id + ".id" if rule.type == "IPSet" else id }}{% if not loop.last %}, {% endif %}
            {%- endfor -%}
            ]
            {% endif %}

            {% if rule.app_port_profile_ids %}
            app_port_profile_ids = [
            {%- for id in rule.app_port_profile_ids -%}
                {{ "module." + id + ".id" if rule.scope == "CUSTOM" else "data.vcd_nsxt_app_port_profile." + id + ".id" }}{% if not loop.last %}, {% endif %}
            {%- endfor -%}
            ]
            {% endif %}
        }{% if not loop.last %},
        {% endif %}
    {% endfor %}
    ]
}
