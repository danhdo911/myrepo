version: '3' 
services: 
   dex: 
      image: {{ prometheus_docker_exporter_image }}
      container_name: docker_exporter 
      volumes: 
         - /var/run/docker.sock:/var/run/docker.sock 
      ports:
{% for port in prometheus_docker_exporter_expose_ports %}
         - {{ port }}
{% endfor %}
      restart: always
