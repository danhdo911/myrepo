{% set exporter = prometheus_exporters
  | selectattr('job_name', 'equalto', 'node-cert-exporter')
  | first %}
{% if monitoring_enabled | default(false) | bool %}
scrape_configs:
  - job_name: node-cert-exporter
    static_configs:
      - targets:
          - {{ monitoring_system_fqdn }}:{{ exporter.port }}
{% endif %}