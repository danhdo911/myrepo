network:
  version: 2
  ethernets:
    {{ ansible_default_ipv4.interface }}:
      dhcp4: false
      dhcp6: false
      addresses: [{{ vm_host_data.networks[0].ip_address }}]
      routes:
        - to: default
          via: {{ vm_host_data.networks[0].ipv4_gateway }}
      nameservers:
        addresses: {{ dns_servers | to_json }}

{% for net in vm_host_data.networks %}
{% if net.alias_name is not none and net.alias_name | length > 0 %}
    {{ net.alias_name }}:
      dhcp4: false
      dhcp6: false
{% if 'eth' not in net.alias_name %}
      addresses:
        - {{ net.ip_address }}
{% endif %}
      match:
        macaddress: {{ net.mac_address }}
      set-name: {{ net.alias_name }}
{% endif %}

{% endfor %}
