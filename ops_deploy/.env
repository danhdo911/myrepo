# System configuration
DOMAIN="dd-iaas.local"
HOSTNAME_OVERRIDE=dd261ctl01
TIMEZONE=Asia/Ho_Chi_Minh
NTP_SERVERS="192.168.138.235"

# Enable/disable system initialization
CONFIGURE_HOSTNAME=true
CONFIGURE_TIMEZONE=true
CONFIGURE_NTP=true
DISABLE_CLOUD_INIT=true
DISABLE_FIREWALL=true

# Enable/disable package groups
INSTALL_COMMON=true
INSTALL_OPENSTACK=true
INSTALL_CEPH=true
INSTALL_PYTHON=true

# Docker Engine
INSTALL_DOCKER=true
DOCKER_VERSION=5:29.8.2-1~ubuntu.24.04~noble
DOCKER_HOLD_VERSION=true

### Only used for Controller01
# Ceph
CEPH_RELEASE=tentacle
CEPH_VERSION=20.2.4
CEPH_IMAGE=quay.io/ceph/ceph:v20.2.4

# Optional Ceph CLI installation
CEPH_INSTALL_COMMON=true