{% for binding in bindings %}
module "{{ binding.network_name }}_dhcp_binding_{{ binding.binding_name }}" {
    source       = "../../modules/vcd/network_dhcp_binding"
    
    vcd_org      = var.vcd_org
    org_dhcp_id  = module.{{ binding.network_name }}_dhcp.id

    name         = "{{ binding.binding_name }}"
    description  = "{{ binding.description }}"
    binding_type = "{{ binding.binding_type }}"
    ip_address   = "{{ binding.ip_address }}"
    mac_address  = "{{ binding.mac_address | lower }}"
    dns_servers  = [{{ binding.dns_server | join(', ') }}]
}

{% endfor %}