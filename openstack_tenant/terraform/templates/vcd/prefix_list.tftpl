{% for module in modules %}
module "{{ module.prefix_list_name }}" {
  source = "../../modules/nsx/nsx-configuration/prefix_list"

  gateway_path     = data.nsxt_policy_tier0_gateway.gw.path
  prefix_list_name = "{{ module.prefix_list_name }}"
  description      = "{{ module.description }}"

  prefixes = [
  {% for p in module.prefixes %}
    {
      action  = "{{ p.action }}"
      {% if p.network %}network = "{{ p.network }}"{% endif %}
      {% if p.le %}le = {{ p.le }}{% endif %}
      {% if p.ge %}ge = {{ p.ge }}{% endif %}
    },
  {% endfor %}
  ]

  {% if module.scope and module.tag %}
  scope = "{{ module.scope }}"
  tag   = "{{ module.tag }}"
  {% endif %}
}
{% endfor %}
