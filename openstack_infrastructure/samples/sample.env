### WORKING DIRECTORIES
PROJECT_DIR=.
WORK_DIR=/workspace

### REGISTRY
HARBOR_REGISTRY="harbor.iij.com.vn"
HARBOR_USER="<HARBOR_USER>"
HARBOR_PASSWORD="<HARBOR_PASSWORD>"

### VAULT Authentication
VAULT_ADDR="https://vault.iij.com.vn"
VAULT_TOKEN="<VAULT_TOKEN>"

### TERRAFORM + VAULT
# TF_PROJECT="openstack_aio_provision"
TF_VAR_vault_path_base="iijvn-ansiblevsphere/data/"
TF_VAR_vault_secret_path="iijvn-ansiblevsphere"
TF_VAR_vault_secret_data="lab/lab199"

### ANSIBLE
ANSIBLE_CONFIG=/workspace/ansible.cfg

### AWS S3 Authentication
### Define if the terraform state is stored in AWS S3
AWS_ACCESS_KEY_ID="<AWS_ACCESS_KEY_ID>"
AWS_SECRET_ACCESS_KEY="<AWS_SECRET_ACCESS_KEY>"
AWS_DEFAULT_REGION="ap-southeast-1"
AWS_CONFIG_FILE="/workspace/aws_config"
AWS_SHARED_CREDENTIALS_FILE="/workspace/aws_credentials"
