{% for profile in profiles %}
module "{{ profile.port_profile_name }}" {
    source                   = "../../modules/vcd/app_port_profile"

    port_profile_name        = "{{ profile.port_profile_name }}"
    port_profile_description = "{{ profile.port_profile_description }}"
    port_protocol            = "{{ profile.port_protocol }}"
    port_app                 = [{{ profile.port_app | join(', ') }}]
}

{% endfor %}