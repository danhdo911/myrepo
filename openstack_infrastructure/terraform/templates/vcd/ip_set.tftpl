{% for ip_set in ip_sets %}
module "ip_set_{{ ip_set.ip_set_name }}" {
    source             = "../../modules/vcd/ip_set"

    vcd_org            = var.vcd_org
    edge_gateway_id    = data.vcd_nsxt_edgegateway.edgegateway.id

    ip_set_name        = "{{ ip_set.ip_set_name }}"
    ip_set_description = "{{ ip_set.ip_set_description }}"
    ip_set_subnets     = [{{ ip_set.ip_set_subnets | join(', ') }}]
}

{% endfor %}