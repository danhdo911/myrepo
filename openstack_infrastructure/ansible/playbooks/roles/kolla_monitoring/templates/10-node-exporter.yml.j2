{% set exporter = prometheus_exporters
  | selectattr('job_name', 'equalto', 'node-exporter')
  | first %}
{% if monitoring_enabled | default(false) | bool %}
scrape_configs:
  - job_name: node-exporter
    static_configs:
      - targets:
{% for host in groups['infra'] %}
          - {{ hostvars[host]['ansible_host'] }}:{{ exporter.port }}
{% endfor %}
{% endif %}