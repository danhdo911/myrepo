{% set exporter = prometheus_exporters
  | selectattr('job_name', 'equalto', 'docker-exporter')
  | first %}
{% if monitoring_enabled | default(false) | bool %}
scrape_configs:
  - job_name: docker-exporter
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - {{ host }}.{{ search_domain[0] }}:{{ exporter.port }}
{% endfor %}
{% endif %}