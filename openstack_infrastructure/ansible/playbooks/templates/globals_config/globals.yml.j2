---
{% if core_services_enabled | default(true) | bool %}
#----------------------- 1. OpenStack Core Services -----------------------#
# General
kolla_install_type: "source"
kolla_base_distro: "ubuntu"
openstack_release: "{{ openstack_release }}"

# Interfaces
network_interface: "ens33"
api_interface: "ens33"
kolla_external_vip_interface: "ens34"
storage_interface: "ens36"
tunnel_interface: "ens35"

# Neutron
neutron_external_interface: "eth1,eth2,eth3,eth4,eth5,eth6,eth7,eth8"
neutron_bridge_name: "br-ex1,br-ex2,br-ex3,br-ex4,br-ex5,br-ex6,br-ex7,br-ex8"
neutron_physical_network: "physnet1,physnet2,physnet3,physnet4,physnet5,physnet6,physnet7,physnet8"
neutron_plugin_agent: "ovn"
enable_neutron_qos: "yes"

# VIP and FQDN
kolla_internal_vip_address: "{{ kolla_internal_vip_address }}"
kolla_internal_fqdn: "{{ kolla_internal_fqdn }}"
kolla_external_vip_address: "{{ kolla_external_vip_address }}"
kolla_external_fqdn: "{{ kolla_external_fqdn }}"

# Services
enable_openstack_core: "yes"
enable_horizon: "yes"
enable_keystone: "yes"
enable_haproxy: "yes"
enable_mariadb: "yes"
enable_memcached: "yes"
enable_masakari: "yes"
enable_hacluster: "yes"
enable_mariabackup: "yes"
enable_cinder_backup: "no"

# Nova
enable_nova: "yes"
nova_compute_virt_type: "kvm"

# Cinder Volume
enable_cinder: "yes"
{% if cinder_nfs_storage_enabled | default(false) | bool %}
enable_cinder_backend_nfs: "yes"
{% else %}
enable_cinder_backend_iscsi: "yes"
{% endif %}
cinder_cluster_skip_precheck: "yes"

# Glance
enable_glance: "yes"
glance_backend_file: "yes"
glance_file_datadir_volume: "/glance"

{% if skyline_enabled | default(true) | bool %}
# Skyline
enable_skyline: "yes"
{% if skyline_console_image is defined %}
skyline_console_image: "{{ skyline_console_image }}"
{% if skyline_console_tag is defined %}
skyline_console_tag: "{{ skyline_console_tag }}"
{% endif %}
{% endif %}
skyline_custom_logos: ["asset", "favicon.ico"]
{% endif %}

{% if registry_private_enabled | default(true) | bool %}
# Registry
docker_registry: "{{ registry_url }}"
docker_registry_insecure: "yes"
docker_namespace: "{{ registry_namespace }}"
{% endif %}

# TLS
kolla_copy_ca_into_containers: "yes"
openstack_cacert: "/etc/ssl/certs/ca-certificates.crt"
kolla_enable_tls_internal: "yes"
kolla_enable_tls_external: "yes"
kolla_enable_tls_backend: "yes"
kolla_admin_openrc_cacert: "{{ '{{ openstack_cacert }}' }}"

# Region
openstack_region_name: "HoChiMinh"

# Dummy variable to allow Ansible to accept this file.
workaround_ansible_issue_8743: yes
{% endif %}

{% if conntainer_proxy_enabled | default(false) | bool %}
# Container Proxy
container_http_proxy: "{{ container_http_proxy }}"
container_https_proxy: "{{ container_https_proxy }}"
container_no_proxy: "{{ container_no_proxy }}"
{% endif %}

{% if skyline_policy_enabled | default(false) | bool %}
#----------------------- 2. Skyline Policy Integration -----------------------#
# Skyline API Server Policy
skyline_apiserver_extra_volumes:
  - {{ skyline_policy_dir }}:/etc/skyline/policy
{% endif %}

{% if higio_portal_enabled | default(false) | bool %}
#----------------------- 3. HIGIO Portal Integration -----------------------#
# Skyline SSO
skyline_enable_sso: "yes"
skyline_addons_static_url: "{{ skyline_addons_static_url }}"

# Keystone
enable_keystone_federation: "yes"
keystone_enable_federation_openid: "yes"
keystone_extra_volumes:
  - {{ metadata_nfs_mountpoint[0].mountpoint }}:/etc/apache2/metadata
{% if keystone_trusted_dashboards | default([]) %}
keystone_trusted_dashboards:
{% for dashboard in keystone_trusted_dashboards %}
  - {{ dashboard }}
{% endfor %}
{% endif %}
{% if keystone_federation_oidc_additional_options | default({}) %}
keystone_federation_oidc_additional_options:
{{ keystone_federation_oidc_additional_options | to_nice_yaml(indent=2) | indent(2, true) }}
{% endif %}
{% endif %}

{% if ldap_horizon_enabled | default(false) | bool %}
#----------------------- 4. LDAP HORIZON Integration -----------------------#
# Horinzon Multidomain for LDAP Integration
horizon_keystone_multidomain: true
horizon_keystone_domain_choices:
  default: Default
  {{ ldap_horizon_domain | lower() }}: {{ ldap_horizon_domain | upper() }}
{% endif %}

{% if monitoring_enabled | default(false) | bool %}
#----------------------- 5. Monitoring System -----------------------#
# Monitoring
enable_prometheus: "yes"
enable_grafana: "no"
enable_prometheus_server: "true"
enable_prometheus_haproxy_exporter: "true"
enable_prometheus_mysqld_exporter: "true"
enable_prometheus_node_exporter: "true"
enable_prometheus_openstack_exporter: "true"
enable_prometheus_blackbox_exporter: "true"
enable_prometheus_libvirt_exporter: "true"
enable_prometheus_rabbitmq_exporter: "true"
enable_prometheus_cadvisor: "false"
enable_prometheus_fluentd_integration: "false"
enable_prometheus_memcached: "false"
enable_prometheus_alertmanager: "false"
enable_prometheus_alertmanager_external: "false"
enable_prometheus_elasticsearch_exporter: "false"
enable_prometheus_etcd_integration: "false"
prometheus_cmdline_extras: "--storage.tsdb.retention.time 0m --storage.tsdb.retention.size 5242880B --web.enable-admin-api"
prometheus_node_exporter_cmdline_extras: "--collector.netdev.address-info --collector.ntp"
prometheus_openstack_exporter_cmdline_extras: "--disable-cinder-agent-uuid --disable-metric=container-infra --disable-service.baremetal --disable-service.container-infra --disable-service.gnocchi --disable-service.database --disable-metric=nova-security_groups"
prometheus_openstack_exporter_compute_api_version: "2.87"
{% endif %}