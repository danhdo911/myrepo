network:
  version: 2
  ethernets:
{% for net in vm_host_data.networks %}
{% if net.alias_name is not none and net.alias_name | length > 0 %}
    {{ net.alias_name }}:
      dhcp4: false
      dhcp6: false
      mtu: {{ 9000 if net.alias_name != 'ens33' else 1500 }}
{% if 'eth' not in net.alias_name %}
      addresses:
        - {{ net.ip_address }}
{% if net.alias_name == 'ens33' %}
      routes:
        - to: default
          via: {{ net.ipv4_gateway }}
      nameservers:
          addresses: {{ dns_servers | to_json }}
{%- if search_domain is defined and search_domain %} 
          search: {{ search_domain | to_json }}
{%- endif %} 
{% endif %}
{% if compute_genenve_subnet is defined and compute_genenve_subnet 
  and net.alias_name == 'ens35' and inventory_hostname in groups['network'] %}
      routes:
        - to: {{ compute_genenve_subnet }}
          via: {{ net.ipv4_gateway }}
{% endif %}
{% endif %}
      match:
        macaddress: {{ net.mac_address }}
      set-name: {{ net.alias_name }}
{% endif %}

{% endfor %}
