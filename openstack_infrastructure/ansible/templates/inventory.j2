[all]

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/tmp/iij_danhdo

[control]
{% for vm in vms.values() if 'ctrl' in vm.name %}
{{ vm.name }} ansible_host={{ vm.networks[0].ip_address.split('/')[0] }}
{% endfor %}

[network]
{% for vm in vms.values() if 'gw' in vm.name %}
{{ vm.name }} ansible_host={{ vm.networks[0].ip_address.split('/')[0] }}
{% endfor %}

[compute]
{% for vm in vms.values() if 'com' in vm.name %}
{{ vm.name }} ansible_host={{ vm.networks[0].ip_address.split('/')[0] }}
{% endfor %}

[nfs_endpoints:children]
control
compute