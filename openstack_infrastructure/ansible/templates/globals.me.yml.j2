---
# defaults
kolla_base_distro: "ubuntu"
openstack_release: "master"
enable_openstack_core: "yes"
enable_fluentd: "no"

# vip
kolla_internal_vip_address: "{{ kolla_internal_vip_address }}"
kolla_internal_fqdn: "{{ kolla_internal_fqdn }}"
kolla_external_vip_address: "{{ kolla_external_vip_address }}"
kolla_external_fqdn: "{{ kolla_external_fqdn }}"

# interfaces
api_interface: "{{ api_interface }}"
kolla_external_vip_interface: "{{ kolla_external_vip_interface }}"
tunnel_interface: "{{ tunnel_interface }}"
storage_interface: "{{ storage_interface }}"

# neutron
neutron_external_interface: "{{ neutron_external_interface }}"
neutron_physical_network: "{{ neutron_physical_network }}"
neutron_bridge_name: "{{ neutron_bridge_name }}"
neutron_plugin_agent: "ovn"
enable_neutron_qos: "yes"
enable_neutron_packet_logging: "yes"
openvswitch_ovs_vsctl_wrapper_enabled: "true"

# nova
nova_compute_virt_type: "qemu"
nova_instance_datadir_volume: "{{ nfs_mountpoint }}/nova_instances"

## cinder
enable_cinder: "yes"
enable_cinder_backend_nfs: "yes"
enable_cinder_backup: "yes"
cinder_backup_driver: "nfs"
cinder_backup_share: "{{ nfs_server_ip }}:{{ nfs_path }}"
cinder_backup_mount_options_nfs: "vers=4"
cinder_cluster_skip_precheck: "true"

## glance
enable_glance: "yes"
glance_backend_file: "yes"
glance_file_datadir_volume: "{{ nfs_mountpoint }}/glance/images"

## tls
kolla_enable_tls_internal: "yes"
kolla_enable_tls_external: "yes"
kolla_enable_tls_backend: "yes"
kolla_copy_ca_into_containers: "yes"
kolla_external_fqdn_cert: "/etc/kolla/certificates/haproxy.pem"
kolla_internal_fqdn_cert: "/etc/kolla/certificates/haproxy-internal.pem"
openstack_cacert: "/etc/ssl/certs/ca-certificates.crt"
