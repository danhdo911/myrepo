#================================ Variables ================================#
variables:
  ROOT_PATH: iijvn
  REPO_DEPLOYMENT_DIR: openstack_infrastructure
  ENVIRONMENT: dev02
  PROJECT: openstack_cgw_provision

#================================ Defaults ================================#
default:
  image: harbor.iij.com.vn/customized-images/iijvn-runner:v1.0
  before_script:
    - umask 077
    - echo "$SSH_PRIVATE_KEY" > /tmp/private_key
    - chmod 600 /tmp/private_key
  after_script:
    - rm -f /tmp/private_key
  tags: [$SERVER_RUNNER_TAG]

#================================ Jobs ================================#
stages:
  - pre-setup
  - plan
  - deploy
  - configure

#======================#
update-lastest-code:
  stage: pre-setup
  environment: '$ENVIRONMENT'
  script:
    - ssh -o StrictHostKeyChecking=no -i /tmp/private_key $HOST_USER@$SERVER_RUNNER
        "cd /$ROOT_PATH/$REPO_DEPLOYMENT_DIR
          && git config credential.helper 'store'
          && echo 'https://${GIT_USER}:${GIT_TOKEN}@gitlab.iij.com.vn' > ~/.git-credentials"

    - ssh -o StrictHostKeyChecking=no -i /tmp/private_key $HOST_USER@$SERVER_RUNNER
        "cd /$ROOT_PATH/$REPO_DEPLOYMENT_DIR
          && git fetch --all
          && git switch $CI_DEFAULT_BRANCH
          && git pull origin $CI_DEFAULT_BRANCH"

    - ssh -o StrictHostKeyChecking=no -i /tmp/private_key $HOST_USER@$SERVER_RUNNER
        "cat /dev/null > ~/.git-credentials"

terraform-plan:
  stage: plan
  needs:
    - update-lastest-code
  environment: '$ENVIRONMENT'
  script:
    - ssh -o StrictHostKeyChecking=no -i /tmp/private_key $HOST_USER@$SERVER_RUNNER
        "cd /$ROOT_PATH/$REPO_DEPLOYMENT_DIR
          && make terraform_plan ENV=$ENVIRONMENT PROJECT=$PROJECT"

terraform-deploy:
  stage: deploy
  needs:
    - terraform-plan
  environment: '$ENVIRONMENT'
  script:
    - ssh -o StrictHostKeyChecking=no -i /tmp/private_key $HOST_USER@$SERVER_RUNNER
        "cd /$ROOT_PATH/$REPO_DEPLOYMENT_DIR
          && make terraform_deploy ENV=$ENVIRONMENT PROJECT=$PROJECT"
  when: manual

setup-os:
  stage: configure
  needs:
    - terraform-deploy
  environment: '$ENVIRONMENT'
  script:
    - ssh -o StrictHostKeyChecking=no -i /tmp/private_key $HOST_USER@$SERVER_RUNNER
        "echo "$VM_SSH_PRIVATE_KEY" | base64 -d > /tmp/vm_private_key
          && chmod 600 /tmp/vm_private_key"
    - ssh -o StrictHostKeyChecking=no -i /tmp/private_key $HOST_USER@$SERVER_RUNNER
        "cd /$ROOT_PATH/$REPO_DEPLOYMENT_DIR
          && make os_setup ENV=$ENVIRONMENT TAG='netplan,os-init,ntp'"
    - ssh -o StrictHostKeyChecking=no -i /tmp/private_key $HOST_USER@$SERVER_RUNNER
        "rm -f /tmp/vm_private_key"
