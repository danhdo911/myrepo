#cloud-config
autoinstall:
    version: 1
    locale: en_US
    keyboard:
        layout: us
    ssh:
      install-server: true
      allow-pw: true
    packages: [open-vm-tools, openssh-server, nano, iputils-ping, curl, jq, glances]
    user-data:
      preserve_hostname: true
      hostname: ubuntu
      timezone: Asia/Ho_Chi_Minh
      chpasswd:
        expire: false
      users:
        - name: ubuntu
          gecos: 'Ubuntu Admin'
          passwd: '$6$ubuntu$6hDGC9q2MOzoNAIiNFw7OMsPpL4ix7Q0ovZKO9i267pE6IPdnTneR5.GYGbp9xlJA7935uj8mvBRpsZZOEemZ/'
          lock_passwd: false
          groups: [adm, sudo]
          sudo: ALL=(ALL) NOPASSWD:ALL
          shell: /bin/bash
    apt:
        primary:
            - arches: [i386, amd64]
              uri: "http://archive.ubuntu.com/ubuntu/"
    late-commands: 
      - sed -i -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/g' /target/etc/ssh/sshd_config
      - lvresize -v -l +100%FREE /dev/mapper/ubuntu--vg-ubuntu--lv
      - resize2fs -p /dev/mapper/ubuntu--vg-ubuntu--lv
      - curtin in-target --target=/target -- apt-get update
      - curtin in-target --target=/target -- apt-get upgrade --yes