[all]

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/tmp/iij_danhdo

[mysql]
{% for vm in vms.values() if 'mysql' in vm.name -%}
{{ vm.name }} ansible_host={{ vm.ip }}
{% endfor %}

[haproxy]
{% for vm in vms.values() if 'haproxy' in vm.name -%}
{{ vm.name }} ansible_host={{ vm.ip }}
{% endfor %}

[monitor:children]
mysql
haproxy

[logs:children]
mysql
haproxy

